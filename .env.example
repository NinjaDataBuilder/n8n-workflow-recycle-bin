# Non-secret runtime configuration for the Workflow Recycle Bin sidecar.
# The CLI writes these values during installation. Do not put the hook token itself here.

RECYCLE_BIN_IMAGE=ghcr.io/ninjadatabuilder/n8n-workflow-recycle-bin:0.1.5
DATABUILDER_NETWORK=n8n_default
N8N_INTERNAL_URL=http://n8n:5678
RECYCLE_BIN_HOOK_TOKEN_FILE=/absolute/path/to/recycle-bin-hook-token
RECYCLE_BIN_VOLUME_NAME=workflow-recycle-bin-data
